GEMINI_API_KEY=YOUR_GEMINI_API_KEY
PORT=3000
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Controle de créditos (backend) ---
# Quando preenchida, LIGA o controle de créditos/planos. Sem ela, app roda em modo MVP livre.
# Pegue em: Supabase > Project Settings > API > service_role (secret). NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: se quiser separar do VITE_SUPABASE_URL (normalmente o mesmo valor)
SUPABASE_URL=

# --- Pagamento (Asaas) ---
ASAAS_API_KEY=
# Sandbox para testes: https://sandbox.asaas.com/api/v3 | Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api.asaas.com/v3
# Opcional: token que o Asaas envia no header asaas-access-token do webhook (valide-o)
ASAAS_WEBHOOK_TOKEN=

# --- Imagens na atividade (Pro/Premium) ---
# Modelo de geração de imagem do Gemini. Padrão: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
